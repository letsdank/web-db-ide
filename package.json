{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "check": "npm run lint && npm run typecheck && npm run test:frontend",
        "test:frontend": "vitest run",
        "test:frontend:watch": "vitest",
        "test:backend": "php artisan test",
        "test": "npm run test:frontend && php artisan test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "axios": "^1.13.6",
        "concurrently": "^9.0.1",
        "eslint": "^10.0.3",
        "globals": "^17.4.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "sass": "^1.98.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1",
        "vite": "^7.0.7",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@gravity-ui/icons": "^2.17.0",
        "@gravity-ui/uikit": "^7.33.0",
        "@monaco-editor/react": "^4.7.0",
        "@vitejs/plugin-react": "^5.1.4",
        "monaco-editor": "^0.55.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "zustand": "^5.0.11"
    }
}
